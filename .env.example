# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed if/when you add server-side admin operations (e.g. a real
# account-deletion API route). Never expose this to the browser and never
# prefix it with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of this app, used for OAuth/email redirect links in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
