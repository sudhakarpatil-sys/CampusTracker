# ──────────────────────────────────────────────────────────────────────────
# CampusTracker — Environment Variables
# ──────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your values.
#   cp .env.example .env.local
#
# NEVER commit .env.local or any file containing real credentials.
# ──────────────────────────────────────────────────────────────────────────

# Supabase — Project Settings → API
# Required for both client and server Supabase operations.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed if/when you add server-side admin operations (e.g. a real
# account-deletion API route). Never expose this to the browser and never
# prefix it with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of this app, used for OAuth/email redirect links.
# In production, set this to your deployment URL (e.g. https://campustracker.vercel.app).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Gemini API key — used for AI-powered timetable and exam import.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
